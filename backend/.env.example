AZURE_OPENAI_ENDPOINT="https://resourcename.openai.azure.com/"
AZURE_OPENAI_KEY="your-azure-openai-key"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# Model deployment names (underscores only — dots are invalid in shell env vars)
AZURE_OPENAI_NANO_DEPLOYMENT="gpt-41-nano"
AZURE_OPENAI_MINI_DEPLOYMENT="gpt-41-mini"
AZURE_OPENAI_FULL_DEPLOYMENT="gpt-41"

AZURE_AI_SEARCH_ENDPOINT="https://searchresourcename.search.windows.net/"
AZURE_AI_SEARCH_KEY="your-azure-ai-search-key"

AZURE_REDIS_HOST="your-redis-cache.redis.cache.windows.net"
AZURE_REDIS_PORT=6380
AZURE_REDIS_KEY="your-azure-redis-key"

AZURE_COSMOS_ENDPOINT="https://yourcosmosdb.documents.azure.com:443/"
AZURE_COSMOS_KEY="your-azure-cosmos-key"
AZURE_COSMOS_DATABASE="javaab"

AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;"
AZURE_BLOB_CONTAINER_PDFS="pdfs"

JWT_SECRET="your-jwt-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS=168

AUTH_MODE="mock"
MOCK_OTP="123456"

# QA safety cap — remove or raise before public launch
DAILY_GLOBAL_CAP=500
